{
  "pluginId": "sentimental-plugin",
  "version": "0.2.9",
  "displayName": "Sentiment Analysis Plugin",
  "description": "LLM-powered rich sentiment analysis: polarity + Plutchik 8-emotion vector + named entities + aspect-based per-entity sentiment. ETL stages for batch enrichment, REST API for chart-ready queries and agent integration.",
  "license": "proprietary",
  "homepage": "https://github.com/WebRobot-Ltd/webrobot-sentimental-plugin",
  "requires": {
    "platformVersion": ">=0.0.0",
    "kernelVersion": ">=0.0.0"
  },
  "dbMigrations": {
    "enabled": true,
    "location": "db/migration"
  },
  "components": [
    {
      "type": "jersey",
      "subId": "sentimental-plugin",
      "jar": "api/webrobot-sentimental-plugin-api-0.2.8.jar",
      "manifest": "api/manifest.json",
      "mainClass": "eu.webrobot.sentiment.SentimentPlugin",
      "bootstrap": "bootstrap"
    },
    {
      "type": "etl",
      "subId": "sentimental-plugin-etl",
      "jar": "etl/etl-0.2.1.jar",
      "manifest": "etl/manifest.json"
    },
    {
      "type": "cli",
      "subId": "sentimental-plugin-cli",
      "jar": "cli/webrobot-sentimental-plugin-cli-0.2.1.jar",
      "optional": true
    },
    {
      "type": "ui",
      "subId": "sentimental-plugin-ui",
      "manifest": "ui/manifest.json",
      "distDir": "ui/dist"
    }
  ]
}